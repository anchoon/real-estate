# 공공데이터포털 일반 인증키 (필수: https://www.data.go.kr/)
DATA_GO_KR_KEY=

# 상품 명세에 맞는 URL로 필요할 때만 변경
TRANSACTION_API_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptTradeDev/getRTMSDataSvcAptTradeDev

# '법원 경매' 또는 '부동산 경매' API 상품의 URL을 입력하세요.
AUCTION_API_URL=

API_TIMEOUT_SECONDS=8

# MongoDB Atlas 무료 M0 연결 문자열
# 예: mongodb+srv://사용자:비밀번호@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=real_estate_hub

# 국토교통부 API 조회 기본값: 서울 마포구, 2026년 9월
DEFAULT_LAWD_CD=11440
DEFAULT_DEAL_YMD=202609

# 전국 선택 시 조회할 시군구 코드(쉼표로 구분). 비워두면 전국 조회를 차단합니다.
# 예: 11440,11680,11710
NATIONWIDE_LAWD_CODES=

# 오늘의 부동산 브리핑 뉴스 RSS 또는 승인받은 뉴스 API URL
NEWS_RSS_URL=https://news.google.com/rss/search?q=%EB%B6%80%EB%8F%99%EC%82%B0&hl=ko&gl=KR&ceid=KR:ko

# GPS → 시군구 코드 변환용 카카오 로컬 REST API 키
KAKAO_REST_API_KEY=
